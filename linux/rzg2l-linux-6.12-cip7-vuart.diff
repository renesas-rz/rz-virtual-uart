+	struct tty_port *tport = &sp->port.state->port;  /* Changed */
+	uint32_t opcode = VSCI_GET_OPCODE(msg);
+
+	if(VSCIR_TX_END == opcode) {
+		if(!kfifo_is_empty(&tport->xmit_fifo)) {  /* Changed */
+			vsci_transmit(sp);
+		} else {
+			sp->vi->tx_start = 0;
+		}
+	} else {
+		dev_err(vd->platdev, "unsupported VSCI REQ 0x%08x was found in %s\n", msg, __func__);
+		return -EIO;
+	}
+
+	if(kfifo_len(&tport->xmit_fifo) < WAKEUP_CHARS)  /* Changed */
+		uart_write_wakeup(&sp->port);
+
+	return 0;
+}
