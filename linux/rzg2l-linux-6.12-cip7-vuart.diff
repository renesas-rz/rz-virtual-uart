+static void vsci_receive(struct sci_port *sp, int bytes, int push)
+{
+	struct uart_port *port = &sp->port;
+	struct tty_port *tport = &port->state->port;
+	struct vsci_device *vd = &sp->vi->vdev;
+	unsigned char *pb;
+	uint64_t *buf, val;
+	int count, c;
+
+	pb = (unsigned char *)vd->rbuf;
+
+	if(bytes > (VSCI_BUF_SIZE / 2)) {
+		pb += VSCI_BUF_SIZE / 2;
+		bytes -= VSCI_BUF_SIZE / 2;
+	}
+
+	buf = (uint64_t *)pb;
+	count = bytes;
+
+	while(bytes > 0) {
+		val = *buf++;
+		pb = (unsigned char *)&val;
+		c = (bytes >= 8) ? 8 : bytes;
+		bytes -= c;
+
+		while(c) {
+			if(uart_handle_sysrq_char(port, *pb)) {
+				c--;
+				pb++;
+				count--;
+				continue;
+			}
+
+			tty_insert_flip_char(tport, *pb, TTY_NORMAL);
+			c--;
+			pb++;
+		}
+	}
+
+	port->icount.rx += count;
+
+	if(push)
+		tty_flip_buffer_push(tport);
+}
+
+static void vsci_transmit(struct sci_port *sp)
+{
+	struct uart_port *port = &sp->port;
+	struct tty_port *tport = &port->state->port;
+	struct vsci_device *vd = &sp->vi->vdev;
+	unsigned char *pb;
+	int bytes, count, actual_count = 0;
+	uint64_t *buf, val;
+	int i;
+
+	buf = (uint64_t *)vd->tbuf;
+	count = kfifo_len(&tport->xmit_fifo);
+	bytes = (count >= VSCI_BUF_SIZE) ? VSCI_BUF_SIZE : count;
+
+	/* Read data from kfifo in 8-byte chunks */
+	while(bytes > 0) {
+		val = 0;
+		pb = (unsigned char *)&val;
+		i = (bytes >= 8) ? 8 : bytes;
+		bytes -= i;
+
+		/* Get each byte from kfifo */
+		while(i > 0) {
+			if (kfifo_get(&tport->xmit_fifo, pb)) {
+				pb++;
+				actual_count++;
+			} else {
+				break;
+			}
+			i--;
+		}
+
+		*buf++ = val;
+	}
+
+	port->icount.tx += actual_count;
+
+	if (actual_count > 0)
+		vsci_send_cmd(vd, vcmd_txd_rdy(actual_count));
+}
