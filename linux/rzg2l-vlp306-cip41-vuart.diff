+static void vsci_receive(struct sci_port *sp, int bytes, int push)
+{
+	struct uart_port *port = &sp->port;
+	struct tty_port *tport = &port->state->port;
+	struct vsci_device *vd = &sp->vi->vdev;
+	unsigned char *pb;
+	uint64_t *buf, val;
+	int count, c;
+
+	pb = (unsigned char *)vd->rbuf;
+
+	if(bytes > (VSCI_BUF_SIZE / 2)) {
+		pb += VSCI_BUF_SIZE / 2;
+		bytes -= VSCI_BUF_SIZE / 2;
+	}
+
+	buf = (uint64_t *)pb;
+
+	count = bytes;
+
+	while(bytes > 0) {
+
+		val = *buf++;
+		pb = (unsigned char *)&val;
+		c = (bytes >= 8) ? 8 : bytes;
+		bytes -= c;
+
+		while(c) {
+			if(uart_handle_sysrq_char(port, *pb)) {
+				c--;
+				pb++;
+				count--;
+				continue;
+			}
+
+			tty_insert_flip_char(tport, *pb, TTY_NORMAL);
+
+			c--;
+			pb++;
+		}
+	}
+
+	port->icount.rx += count;
+
+	if(push)
+		tty_flip_buffer_push(tport);
+}
+
+static void vsci_transmit(struct sci_port *sp)
+{
+	struct uart_port *port = &sp->port;
+	struct circ_buf *xmit = &port->state->xmit;
+	struct vsci_device *vd = &sp->vi->vdev;
+	unsigned char *pb;
+	int bytes, count;
+	uint64_t *buf, val, c;
+
+	buf = (uint64_t *)vd->tbuf;
+	count = uart_circ_chars_pending(xmit);
+	bytes = (count >= VSCI_BUF_SIZE) ? VSCI_BUF_SIZE : count;
+	count = bytes;
+
+	while(bytes > 0) {
+
+		val = 0;
+		pb = (unsigned char *)&val;
+		c = (bytes >= 8) ? 8 : bytes;
+		bytes -= c;
+
+		while(c) {
+			*pb = xmit->buf[xmit->tail];
+			xmit->tail = (xmit->tail + 1) & (UART_XMIT_SIZE - 1);
+
+			c--;
+			pb++;
+		}
+
+		*buf++ = val;
+	}
+
+	port->icount.tx += count;
+
+	vsci_send_cmd(
+		vd,
+		vcmd_txd_rdy(count)
+	);
+}
